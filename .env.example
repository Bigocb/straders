# Account token used only to register new agents (dashboard → Settings → Generate Account Token)
# ST_ACCOUNT_TOKEN=your-account-token

# Agent token (auto-saved to .st-token after registration). Overrides .st-token if set.
# ST_TOKEN=your-agent-token

# Optional agent symbol to register (only needed on first run)
# ST_AGENT_SYMBOL=MYAGENT01

# Starting faction (default COSMIC)
# ST_FACTION=COSMIC

# Max engine ticks before stopping (default 100000)
# ST_MAX_TICKS=100

# Optional custom DB path
# ST_DB=/path/to/startraders.db

# ── Co-pilot (command-center chat agent) ─────────────────────────────
# Enables the chat panel in the command center. Uses an OpenAI-compatible
# endpoint (defaults to Ollama cloud). Set ST_LLM_API_KEY to enable.
# ST_LLM_API_KEY=your-llm-api-key
# ST_LLM_MODEL=deepseek-v4-flash:0731
# ST_LLM_BASE_URL=https://ollama.com/v1
